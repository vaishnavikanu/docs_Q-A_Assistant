# Solstice Docs Q&A Assistant Configuration

# Google Gemini API Key (Required for semantic embeddings and grounded answer generation)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database URL
DATABASE_URL=sqlite:///./solstice_docs.db

# Model Configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Retrieval & Threshold Configuration
CHUNK_SIZE=400
RRF_K=60
TOP_K_CHUNKS=3
BM25_SCORE_FLOOR=0.05
COSINE_SCORE_FLOOR=0.40

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
